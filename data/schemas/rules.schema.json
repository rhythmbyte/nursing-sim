{
  "title": "Flag rule defaults",
  "type": "object",
  "required": ["rules"],
  "properties": {
    "review": { "enum": ["approved", "proposed", "partial"] },
    "rules": {
      "type": "object",
      "properties": {
        "priority-order": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" } } },
        "tier-timeout": { "type": "object", "required": ["severity"] },
        "call-light-response": { "type": "object" },
        "parameter-breach": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" } } },
        "inappropriate-delegation": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" } } },
        "allergy-conflict": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" }, "classes": { "type": "object" } } },
        "prn-limit": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" } } },
        "left-unattended": { "type": "object", "properties": { "severity": { "$ref": "#/$defs/severity" } } },
        "alarm-response": { "type": "object", "properties": { "enabled": { "type": "boolean" } } },
        "timeliness": { "type": "object", "required": ["orders", "scheduledMeds", "callLights", "alarms", "tags", "groupStatus", "tracking"] },
        "priority-mismatch": { "type": "object", "properties": { "enabled": { "type": "boolean" }, "severity": { "$ref": "#/$defs/severity" }, "graceMin": { "type": "number", "minimum": 0 }, "flagUnassigned": { "type": "boolean" } } }
      }
    },
    "vitalsCompare": { "type": "object", "properties": { "tolerance": { "type": "object" } } }
  },
  "$defs": { "severity": { "enum": ["red", "amber"] } }
}

{
  "title": "Setting presets",
  "type": "object",
  "required": ["presets"],
  "properties": {
    "review": { "enum": ["approved", "proposed", "partial"] },
    "presets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "description", "settings"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "label": { "type": "string", "minLength": 1 },
          "description": { "type": "string" },
          "settings": { "type": "object" },
          "speed": { "type": "number" },
          "generate": { "type": "object", "properties": { "cases": { "type": "object" }, "mix": { "type": "object" } } }
        }
      }
    }
  }
}

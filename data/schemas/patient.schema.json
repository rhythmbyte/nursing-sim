{
  "title": "Patient template",
  "type": "object",
  "required": ["id", "review", "demographics", "tag", "admittingDx", "codeStatus", "allergies", "vitals", "findings", "labs", "orders", "events", "outcome", "debrief"],
  "properties": {
    "id": { "type": "string", "pattern": "^p[0-9a-z-]+$" },
    "review": { "$ref": "#/$defs/review" },
    "reviewNotes": { "type": "array", "items": { "type": "string" } },
    "source": { "type": "string" },
    "demographics": {
      "type": "object",
      "required": ["name", "age", "sex", "room"],
      "properties": {
        "name": { "type": "string", "minLength": 1 },
        "age": { "type": "integer", "minimum": 0 },
        "sex": { "type": "string" },
        "room": { "type": "string" }
      }
    },
    "case": {
      "type": "object",
      "description": "Case template (engine/cases.js): the sim instantiates a concrete patient from a seed.",
      "properties": {
        "title": { "type": "string", "minLength": 1 },
        "code": { "type": "string", "pattern": "^[A-Z0-9]{1,6}$" },
        "sex": { "enum": ["M", "F", "either"] },
        "ageRange": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
        "excludeDrugs": { "type": "array", "items": { "type": "string" } },
        "locked": { "type": "array", "items": { "type": "object", "required": ["seed"], "properties": { "seed": { "type": "string", "minLength": 1 }, "nominal": { "type": "boolean" }, "label": { "type": "string" } } } },
        "review": { "$ref": "#/$defs/review" }
      }
    },
    "tag": { "$ref": "#/$defs/tag" },
    "priorityLabel": { "type": "string" },
    "admittingDx": { "type": "string", "minLength": 1 },
    "codeStatus": { "type": "string" },
    "allergies": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["agent"],
        "properties": { "agent": { "type": "string" }, "reaction": { "type": "string" } }
      }
    },
    "allergyText": { "type": "string" },
    "hpi": { "type": "string" },
    "pmh": { "type": "array", "items": { "type": "string" } },
    "homeMeds": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["name"],
        "properties": { "name": { "type": "string" }, "dose": { "type": "string" }, "freq": { "type": "string" }, "medClass": { "type": "string" } }
      }
    },
    "handoff": {
      "type": "object",
      "properties": {
        "review": { "$ref": "#/$defs/review" },
        "situation": { "type": "string" },
        "background": { "type": "string" },
        "assessment": { "type": "string" },
        "recommendation": { "type": "string" }
      }
    },
    "vitals": {
      "type": "object",
      "required": ["baseline"],
      "properties": {
        "review": { "$ref": "#/$defs/review" },
        "baseline": { "$ref": "#/$defs/vitalValues" },
        "ranges": { "type": "object", "properties": { "hr": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "rr": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "spo2": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "tempF": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "sbp": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 }, "dbp": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 } } },
        "rangesReview": { "$ref": "#/$defs/review" },
        "keyframes": {
          "type": "array",
          "items": {
            "type": "object",
            "anyOf": [{ "required": ["values"] }, { "required": ["valuesRel"] }],
            "anyOfMessage": "keyframe needs values or valuesRel",
            "properties": {
              "atMin": { "type": "integer", "minimum": 0 },
              "eventId": { "type": "string" },
              "values": { "$ref": "#/$defs/vitalValues" },
              "valuesRel": { "$ref": "#/$defs/vitalDeltas" }
            }
          }
        }
      }
    },
    "findings": {
      "type": "object",
      "required": ["baseline"],
      "properties": {
        "baseline": { "type": "array", "items": { "type": "string" } },
        "changes": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["eventId", "findings"],
            "properties": {
              "eventId": { "type": "string" },
              "findings": { "type": "array", "items": { "type": "string" } }
            }
          }
        }
      }
    },
    "labs": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["code", "status"],
        "properties": {
          "code": { "type": "string" },
          "label": { "type": "string" },
          "value": { "type": ["string", "null"] },
          "unit": { "type": "string" },
          "status": { "enum": ["resulted", "pending"] },
          "resultDelayMin": { "type": "integer", "minimum": 0 },
          "forOrder": { "type": "string", "pattern": "^o-" },
          "range": { "type": "array", "items": { "type": "number" }, "minItems": 2, "maxItems": 2 },
          "rangeReview": { "$ref": "#/$defs/review" },
          "teachingPoint": { "type": "boolean" },
          "review": { "$ref": "#/$defs/review" }
        }
      }
    },
    "orders": { "type": "array", "items": { "$ref": "#/$defs/order" } },
    "events": { "type": "array", "items": { "$ref": "#/$defs/event" } },
    "outcome": {
      "type": "object",
      "required": ["mode"],
      "properties": { "mode": { "enum": ["survive", "die", "instructor"] }, "notes": { "type": "string" } }
    },
    "codeBranch": { "type": ["object", "null"] },
    "assessments": {"type": "object", "properties": {"baseline": {"type": "object"}}},
    "normalRanges": {"type": "object"},
    "patientTags": {"type": "object"},
    "script": {"type": "object", "required": ["initialState", "states", "reactions"], "properties": {"review": {"$ref": "#/$defs/review"}, "initialState": {"type": "string"}, "states": {"type": "array", "items": {"$ref": "#/$defs/scriptState"}}, "reactions": {"type": "array", "items": {"$ref": "#/$defs/reaction"}}}},
    "monitor": { "type": "object", "properties": { "tempProbe": { "type": "boolean" } } },
    "vitalsPresets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "label", "values"],
        "properties": { "id": { "type": "string" }, "label": { "type": "string" }, "values": { "$ref": "#/$defs/vitalValues" }, "overMin": { "type": "number", "minimum": 0 }, "review": { "$ref": "#/$defs/review" } }
      }
    },
    "debrief": {
      "type": "object",
      "required": ["shouldRecognize"],
      "properties": {
        "shouldRecognize": { "type": "array", "items": { "type": "string" } },
        "instructorNotes": { "type": "array", "items": { "type": "string" } }
      }
    }
  },
  "$defs": {
    "fieldTest": {"type": "object", "properties": {"min": {"type": "number"}, "max": {"type": "number"}, "equals": {"type": ["string", "number"]}, "matches": {"type": "array", "items": {"type": "string", "minLength": 1}}, "excludes": {"type": "array", "items": {"type": "string", "minLength": 1}}}},
    "matcher": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["intervention", "order", "med"]}, "interventionId": {"type": "string"}, "orderId": {"type": "string"}, "med": {"type": "string"}, "result": {"enum": ["given", "held", "not-given"]}, "dose": {"$ref": "#/$defs/fieldTest"}, "where": {"type": ["object", "array"]}}},
    "scriptState": {"type": "object", "required": ["id", "label"], "properties": {"id": {"type": "string", "pattern": "^[a-z0-9-]+$"}, "label": {"type": "string", "minLength": 1}, "vitals": {"type": "object", "properties": {"values": {"$ref": "#/$defs/vitalValues"}, "valuesRel": { "$ref": "#/$defs/vitalDeltas" }, "overMin": {"type": "number", "minimum": 0}, "overMinBy": {"type": "object"}}}, "rhythm": {"type": "string", "minLength": 1}, "findings": {"type": "string", "minLength": 1}, "note": {"type": "string"}, "assessments": {"type": "object"}, "review": {"$ref": "#/$defs/review"}}},
    "trigger": {"type": "object", "required": ["kind"], "properties": {"kind": {"enum": ["intervention", "order", "med", "vitals", "duration", "elapsed", "fired", "penalty", "assessment"]}, "toolId": {"type": "string"}, "rise": {"type": "number"}, "interventionId": {"type": "string"}, "orderId": {"type": "string"}, "med": {"type": "string"}, "result": {"enum": ["given", "held", "not-given"]}, "dose": {"$ref": "#/$defs/fieldTest"}, "where": {"type": ["object", "array"]}, "field": {"enum": ["spo2", "hr", "rr", "sbp", "dbp", "tempF", "gcs", "glucose"]}, "op": {"enum": ["<=", "<", ">=", ">"]}, "value": {"type": "number"}, "since": {"enum": ["state", "event", "reaction", "start"]}, "state": {"type": "string"}, "eventId": {"type": "string"}, "reactionId": {"type": "string"}, "afterMin": {"type": "number", "minimum": 0}, "forMin": {"type": "number", "minimum": 0}, "atLeastPercent": {"type": "number", "minimum": 0, "maximum": 100}, "without": {"type": "array", "items": {"$ref": "#/$defs/matcher"}}}},
    "effect": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["state", "vitals", "findings", "event", "fire", "penalty", "assessment"]}, "answers": {"type": "object"}, "label": {"type": "string"}, "percent": {"type": "number", "minimum": 0, "maximum": 100}, "caps": {"type": "object"}, "vitals": {"type": "array", "items": {"enum": ["spo2", "hr", "rr", "sbp", "dbp", "tempF"]}}, "wearOffMin": {"type": "number", "minimum": 0}, "slowFactor": {"type": "number", "minimum": 1}, "to": {"type": "string"}, "values": {"$ref": "#/$defs/vitalValues"}, "valuesRel": { "$ref": "#/$defs/vitalDeltas" }, "overMin": {"type": "number", "minimum": 0}, "change": {"type": "string"}, "eventId": {"type": "string"}, "event": {"type": "object", "required": ["type"], "properties": {"type": {"enum": ["new-orders", "call-light", "staff-message", "lab-result", "code", "admission"]}, "payload": {"type": "object"}}}}},
    "reaction": {"type": "object", "required": ["id", "when", "then"], "properties": {"id": {"type": "string", "pattern": "^r-"}, "label": {"type": "string"}, "short": {"type": "string", "maxLength": 28}, "review": {"$ref": "#/$defs/review"}, "when": {"$ref": "#/$defs/trigger"}, "if": {"type": "object", "properties": {"inState": {"type": "array", "items": {"type": "string"}}, "notInState": {"type": "array", "items": {"type": "string"}}, "vitals": {"type": "object"}, "done": {"type": "array", "items": {"$ref": "#/$defs/matcher"}}, "notDone": {"type": "array", "items": {"$ref": "#/$defs/matcher"}}, "betweenMin": {"type": "array", "items": {"type": "number"}}}}, "then": {"type": "array", "items": {"$ref": "#/$defs/effect"}}, "repeat": {"type": "boolean"}, "maxFires": {"type": "integer", "minimum": 1}}},
    "review": { "enum": ["approved", "proposed", "partial"] },
    "tag": { "enum": ["red", "yellow", "green", "black"] },
    "vitalDeltas": { "type": "object", "description": "Change from this patient's baseline, e.g. { \"sbp\": -30, \"hr\": 20 }", "properties": { "hr": { "type": "number" }, "rr": { "type": "number" }, "spo2": { "type": "number" }, "tempF": { "type": "number" }, "sbp": { "type": "number" }, "dbp": { "type": "number" } } },
    "vitalValues": {
      "type": "object",
      "properties": {
        "bp": { "type": "string", "pattern": "^\\d{2,3}/\\d{2,3}$" },
        "hr": { "type": "number" },
        "rr": { "type": "number" },
        "tempF": { "type": "number" },
        "spo2": { "type": "number", "minimum": 0, "maximum": 100 },
        "o2": { "type": "string" },
        "pain": { "type": "string" },
        "rhythm": { "type": "string", "minLength": 1 }
      }
    },
    "order": {
      "type": "object",
      "required": ["id", "text", "type", "tier", "orderSet", "interventionIds", "delegable"],
      "anyOf": [{ "required": ["activeFromMin"] }, { "required": ["activeOnEvent"] }],
      "anyOfMessage": "order needs activeFromMin or activeOnEvent",
      "properties": {
        "id": { "type": "string", "pattern": "^o-" },
        "text": { "type": "string", "minLength": 1 },
        "type": { "enum": ["once", "scheduled", "prn", "continuous", "parameter"] },
        "assessment": { "type": "object", "required": ["tools"], "properties": { "tools": { "type": "array", "items": { "type": "string" } }, "everyMin": { "type": "number", "minimum": 1 }, "once": { "type": "boolean" }, "afterDoseMin": { "type": "number", "minimum": 0 } } },
        "tier": { "enum": [1, 2, 3] },
        "review": { "$ref": "#/$defs/review" },
        "orderSet": { "type": "string" },
        "activeFromMin": { "type": "integer", "minimum": 0 },
        "activeOnEvent": { "type": "string" },
        "interventionIds": { "type": "array", "items": { "type": "string" } },
        "frequencyMin": { "type": "integer", "minimum": 1 },
        "medClass": { "type": "string" },
        "prn": {
          "type": "object",
          "properties": {
            "max": { "type": "integer", "minimum": 1 },
            "intervalMin": { "type": "integer", "minimum": 0 },
            "requiresBefore": { "type": "array", "items": { "type": "string" } },
            "requiresWithinMin": { "type": "integer", "minimum": 1 }
          }
        },
        "parameter": {
          "type": "object",
          "required": ["requires", "withinMin"],
          "properties": {
            "watch": { "type": "string" },
            "watchEvent": { "type": "string" },
            "op": { "enum": ["<", "<=", ">", ">=", "=="] },
            "value": { "type": "number" },
            "requires": { "type": "string" },
            "withinMin": { "type": "integer", "minimum": 0 }
          }
        },
        "delegable": { "type": "boolean" }
      }
    },
    "event": {
      "type": "object",
      "required": ["id", "type", "payload"],
      "anyOf": [{ "required": ["atMin"] }, { "required": ["trigger"] }],
      "anyOfMessage": "event needs atMin or trigger",
      "properties": {
        "id": { "type": "string", "pattern": "^e-" },
        "type": { "enum": ["new-orders", "call-light", "vitals-change", "findings-change", "staff-message", "lab-result", "code", "admission", "ems-arrival", "assessment-change", "script-state"] },
        "atMin": { "type": "integer", "minimum": 0 },
        "group": { "type": "string", "minLength": 1 },
        "repeatEveryMin": { "type": "integer", "minimum": 1 },
        "repeatCount": { "type": "integer", "minimum": 1 },
        "review": { "$ref": "#/$defs/review" },
        "payload": { "type": "object" }
      }
    }
  }
}

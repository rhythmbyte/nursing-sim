{
  "title": "Assessment tools catalog",
  "type": "object",
  "required": ["categories", "tools"],
  "properties": {
    "review": { "enum": ["approved", "proposed", "partial"] },
    "categories": { "type": "array", "items": { "type": "string" } },
    "tools": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["id", "name", "category", "items", "license", "reassessMin", "delegableTo"],
        "properties": {
          "id": { "type": "string", "pattern": "^[a-z0-9-]+$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "enum": ["neuro", "falls", "skin", "pain", "sedation", "withdrawal", "systems", "early-warning"] },
          "review": { "enum": ["approved", "proposed", "partial"] },
          "scoring": { "enum": ["sum", "single", "rule", "auto", "none"] },
          "reassessMin": { "type": "number", "minimum": 0 },
          "delegableTo": { "type": "array", "items": { "enum": ["LPN", "CNA"] } },
          "vitalsField": { "type": "string" },
          "lowerIsWorse": { "type": "boolean" },
          "license": { "type": "object", "required": ["status"], "properties": { "status": { "enum": ["public", "permission-needed", "unknown"] }, "note": { "type": "string" } } },
          "items": { "type": "array", "items": { "type": "object", "required": ["id", "label", "type"], "properties": {
            "id": { "type": "string", "minLength": 1 }, "label": { "type": "string", "minLength": 1 }, "type": { "enum": ["choice", "scale", "numeric", "text"] },
            "min": { "type": "number" }, "max": { "type": "number" },
            "options": { "type": "array", "items": { "type": "object", "required": ["label", "points"], "properties": { "label": { "type": "string" }, "points": { "type": "number" } } } } } } },
          "bands": { "type": "array", "items": { "type": "object", "required": ["min", "max", "label", "tone"], "properties": { "min": { "type": "number" }, "max": { "type": "number" }, "label": { "type": "string" }, "tone": { "enum": ["green", "yellow", "red", "neutral"] } } } }
        }
      }
    }
  }
}

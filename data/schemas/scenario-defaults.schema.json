{
  "title": "Scenario setting defaults",
  "type": "object",
  "required": ["settings"],
  "properties": {
    "review": { "enum": ["approved", "proposed", "partial"] },
    "settings": {
      "type": "object",
      "required": [
        "handoffMode",
        "chargeNurse",
        "showTagsTo",
        "priorityScale",
        "vitalsCycleDefaultMin",
        "pauseOnClose",
        "revealManualVitals",
        "staffPool", "delegationQueue",
        "prnPreCheckWindowMin",
        "delegatedAssessmentRevealsFindings", "codeTag", "scriptedVitalsAfterInstructor", "reactionMaxFires", "reactionMaxPerInstant", "recoveryPenalties", "recoveryPenaltyMaxPercent", "assessmentTools", "revealAssessmentFindings", "gradeAssessments", "taskTimerMode", "taskTimerManikinFactor", "taskTimerMinLockoutSec", "roscTag", "roscRhythm", "noRoscRhythm", "messages"
      ],
      "properties": {
        "handoffMode": { "enum": ["once", "always", "never"] },
        "chargeNurse": { "enum": ["student", "instructor", "off"] },
        "showTagsTo": { "type": "array", "items": { "enum": ["instructor", "student", "charge"] } },
        "priorityScale": { "type": "string", "minLength": 1 },
        "vitalsCycleDefaultMin": { "type": "integer", "minimum": 0 },
        "pauseOnClose": { "type": "boolean" },
        "revealManualVitals": { "type": "boolean" },
        "rules": { "type": "object" },
        "staffPool": { "type": "object", "properties": { "CNA": { "type": "integer", "minimum": 0 }, "LPN": { "type": "integer", "minimum": 0 } } },
        "delegationQueue": { "type": "boolean" },
        "prnPreCheckWindowMin": { "type": "integer", "minimum": 1 },
        "delegatedAssessmentRevealsFindings": { "type": "boolean" },
        "codeTag": { "enum": ["red", "yellow", "green", "black"] },
        "scriptedVitalsAfterInstructor": { "enum": ["apply", "skip"] },
        "reactionMaxFires": { "type": "integer", "minimum": 1 },
        "reactionMaxPerInstant": { "type": "integer", "minimum": 1 },
        "recoveryPenalties": { "type": "boolean" },
        "recoveryPenaltyMaxPercent": { "type": "number", "minimum": 0, "maximum": 95 },
        "assessmentTools": { "type": ["string", "array"] },
        "revealAssessmentFindings": { "type": "boolean" },
        "gradeAssessments": { "type": "boolean" },
        "taskTimerMode": { "enum": ["screen-only", "manikin", "off"] },
        "taskTimerManikinFactor": { "type": "number", "minimum": 0, "maximum": 1 },
        "taskTimerMinLockoutSec": { "type": "number", "minimum": 0 },
        "taskDurations": { "type": "object" },
        "roscTag": { "enum": ["red", "yellow", "green", "black"] },
        "roscRhythm": { "type": "string" },
        "noRoscRhythm": { "type": "string" },
        "messages": { "type": "object", "properties": { "codeStarted": { "type": "string" }, "rosc": { "type": "string" }, "noRosc": { "type": "string" } } }
      }
    }
  }
}

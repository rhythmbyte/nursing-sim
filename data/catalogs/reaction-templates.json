{
  "review": "proposed",
  "_comment": "Reusable reaction templates for the patient editor (Script → Add from template). Each adds its states and reactions to a patient; ids that are taken get a suffix. States may carry findingsText (lines) instead of a findings change id. Clinical values are proposed: SPEC §14.",
  "templates": [
    {
      "id": "o2-response", "label": "O₂ response", "review": "proposed",
      "description": "Low flow helps a little; higher flow or a non-rebreather brings SpO₂ up. Not for COPD targets (see Linda Garcia for that).",
      "states": [
        { "id": "o2-partial", "label": "Some O₂ response (SpO₂ about 89%)", "vitals": { "values": { "spo2": 89 }, "overMin": 3 } },
        { "id": "o2-good", "label": "Good O₂ response (SpO₂ about 95%)", "vitals": { "values": { "spo2": 95, "rr": 22 }, "overMin": 5 } }
      ],
      "reactions": [
        { "id": "r-o2-low", "label": "O₂ 1–3 L: some response", "when": { "kind": "intervention", "interventionId": "o2-apply", "where": { "lpm": { "min": 1, "max": 3 }, "device": { "excludes": ["NRB", "non-rebreather"] } } }, "if": { "notInState": ["o2-partial", "o2-good"] }, "then": [{ "type": "state", "to": "o2-partial" }], "repeat": true, "maxFires": 5 },
        { "id": "r-o2-high", "label": "O₂ ≥ 4 L or NRB: good response", "when": { "kind": "intervention", "interventionId": "o2-apply", "where": [{ "lpm": { "min": 4 } }, { "device": { "matches": ["NRB", "non-rebreather"] } }] }, "if": { "notInState": ["o2-good"] }, "then": [{ "type": "state", "to": "o2-good" }], "repeat": true, "maxFires": 5 }
      ]
    },
    {"id": "neglect-penalty", "label": "Neglect penalty", "review": "proposed", "description": "Late treatment helps less: SpO₂ < 80 for 5+ min reduces SpO₂ recovery by 20% for the rest of the sim; SBP < 90 for 10+ min reduces BP recovery by 20% and makes it 1.5× slower.", "states": [], "reactions": [{"id": "r-neglect-hypoxia", "label": "SpO₂ < 80% for 5+ min: recovery reduced 20%", "when": {"kind": "duration", "field": "spo2", "op": "<", "value": 80, "forMin": 5}, "then": [{"type": "penalty", "label": "Hypoxic 5+ min", "percent": 20, "vitals": ["spo2"]}]}, {"id": "r-neglect-hypotension", "label": "SBP < 90 for 10+ min: BP recovery reduced 20%, slower", "when": {"kind": "duration", "field": "sbp", "op": "<", "value": 90, "forMin": 10}, "then": [{"type": "penalty", "label": "Hypotensive 10+ min", "percent": 20, "vitals": ["sbp", "dbp"], "slowFactor": 1.5}]}]},
    {
      "id": "fluid-bolus", "label": "Fluid bolus response", "review": "proposed",
      "description": "A bolus of 500 mL or more brings BP up and HR down over 10 minutes.",
      "states": [
        { "id": "fluids-better", "label": "Better after fluids", "vitals": { "values": { "bp": "104/62", "hr": 104 }, "overMin": 10 }, "findingsText": ["Capillary refill 2–3 seconds", "Making more urine"] }
      ],
      "reactions": [
        { "id": "r-bolus", "label": "Bolus ≥ 500 mL: perfusion improves", "when": { "kind": "intervention", "interventionId": "iv-fluids", "where": { "volumeMl": { "min": 500 } } }, "if": { "notInState": ["fluids-better"] }, "then": [{ "type": "state", "to": "fluids-better" }] }
      ]
    }
  ]
}

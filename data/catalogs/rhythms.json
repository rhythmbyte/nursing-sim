{
  "review": "proposed",
  "_comment": "Cardiac rhythms for the bedside monitor. 'draw' says how the ECG is drawn: shape (sinus = P-QRS-T complexes, fib = fibrillatory baseline + QRS, vf = chaotic wave, flat = asystole), p (P waves), qrsWide, irregular (0-1 beat-to-beat variation), fibAmp (baseline wobble), vfFreq. pulseless: true = no pulse: SpO2, pleth and RR show nothing (RR '--' during an arrest; SPEC §14). showsRate: false = HR shows --. alarm: true = always alarms. aliases: other names accepted (e.g. a code event's rhythm 'PEA').",
  "rhythms": {
    "sinus": { "label": "Sinus rhythm", "draw": {"shape": "sinus", "p": true} },
    "sinus-tach": { "label": "Sinus tachycardia", "draw": {"shape": "sinus", "p": true}, "aliases": ["sinus tach", "ST"] },
    "sinus-brady": { "label": "Sinus bradycardia", "draw": {"shape": "sinus", "p": true}, "aliases": ["sinus brady", "SB"] },
    "afib": {
      "label": "Atrial fibrillation",
      "draw": { "shape": "fib", "p": false, "irregular": 0.35, "fibAmp": 0.06 },
      "aliases": ["a-fib", "AF", "atrial fibrillation"]
    },
    "pea": {
      "label": "PEA",
      "draw": { "shape": "sinus", "p": true },
      "alarm": true,
      "aliases": ["PEA", "pulseless electrical activity"],
      "pulseless": true
    },
    "asystole": { "label": "Asystole", "draw": {"shape": "flat"}, "showsRate": false, "alarm": true, "pulseless": true },
    "vf": {
      "label": "Ventricular fibrillation",
      "draw": { "shape": "vf", "vfFreq": 5 },
      "showsRate": false,
      "alarm": true,
      "aliases": ["VF", "v-fib"],
      "pulseless": true
    },
    "vt": {
      "label": "Ventricular tachycardia",
      "draw": { "shape": "sinus", "p": false, "qrsWide": true },
      "alarm": true,
      "aliases": ["VT", "v-tach"]
    },
    "pvt": {
      "label": "Pulseless ventricular tachycardia",
      "draw": { "shape": "sinus", "p": false, "qrsWide": true },
      "pulseless": true,
      "alarm": true,
      "aliases": ["pVT", "pulseless VT", "pulseless v-tach"]
    }
  }
